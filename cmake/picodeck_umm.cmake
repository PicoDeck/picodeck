# umm_malloc's heap init without its clear (issue #73).
#
# umm_multi_init_heap() memsets the whole heap to 0 and then writes the three
# block headers that make it one free block; the headers' other fields rely
# on that zero fill. On the device the heap is the 6 MB of QMI PSRAM at
# 0x11200000, and the memset through the cached alias took ~0.79 s of every
# boot and flooded the QMI (it allocated every line, evicting Core 1's
# animation code from the XIP cache). lua_psram_alloc.c now zeroes the heap
# itself, by DMA through the uncached alias while the display initialises,
# so the init only has the headers to write.
#
# Upstream umm_malloc (third_party/umm_malloc, a submodule we do not fork) has
# no option to skip the clear, so the firmware compiles a copy of
# umm_malloc.c in which it is guarded by UMM_HEAP_PRECLEARED (defined for the
# firmware in src/os/umm_malloc_cfgport.h, which umm_malloc.c includes before
# the init). The simulator's --real-umm (simulator/stubs/sim_real_umm.c)
# includes the original file and keeps the clear.
#
# picodeck_umm_source(<out_var> <umm_src_dir>) sets <out_var> to the patched
# copy (written under CMAKE_CURRENT_BINARY_DIR/umm_patched; the submodule is
# never modified). Its quote-form includes (umm_malloc_cfg.h, umm_malloc.h,
# umm_info.c ...) find nothing next to the copy, so the caller keeps
# <umm_src_dir> on the include path. The build fails if the upstream text
# drifts.

set(_PICODECK_UMM_FROM
"    UMM_NUMBLOCKS = (UMM_HEAPSIZE / UMM_BLOCKSIZE);
    memset(UMM_HEAP, 0x00, UMM_HEAPSIZE);
")
set(_PICODECK_UMM_TO
"    UMM_NUMBLOCKS = (UMM_HEAPSIZE / UMM_BLOCKSIZE);
    /* PicoDeck (cmake/picodeck_umm.cmake): with UMM_HEAP_PRECLEARED the caller
     * hands over a heap that already reads as zero, so the header fields this
     * init leaves alone are 0 as umm expects. */
#ifndef UMM_HEAP_PRECLEARED
    memset(UMM_HEAP, 0x00, UMM_HEAPSIZE);
#endif
")

function(picodeck_umm_source _out _dir)
    set(_src "${_dir}/umm_malloc.c")
    set(_gen "${CMAKE_CURRENT_BINARY_DIR}/umm_patched")
    set(_dst "${_gen}/umm_malloc.c")
    file(MAKE_DIRECTORY "${_gen}")
    file(READ "${_src}" _text)
    string(REPLACE "\r\n" "\n" _text "${_text}")
    string(FIND "${_text}" "${_PICODECK_UMM_FROM}" _at)
    string(REPLACE "${_PICODECK_UMM_FROM}" "" _rest "${_text}")
    string(LENGTH "${_text}" _lt)
    string(LENGTH "${_rest}" _lr)
    string(LENGTH "${_PICODECK_UMM_FROM}" _lf)
    math(EXPR _n "(${_lt} - ${_lr}) / ${_lf}")
    if(_at EQUAL -1 OR NOT _n EQUAL 1)
        message(FATAL_ERROR
            "picodeck_umm: expected the heap clear in umm_multi_init_heap() once "
            "in ${_src}, found it ${_n} times. umm_malloc changed: update "
            "cmake/picodeck_umm.cmake.")
    endif()
    string(REPLACE "${_PICODECK_UMM_FROM}" "${_PICODECK_UMM_TO}" _text "${_text}")
    set(_text "/* PicoDeck: generated by cmake/picodeck_umm.cmake from\n   ${_src} — do not edit. */\n${_text}")
    # Re-run the patch when upstream changes.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_src}")
    set(${_out} "${_dst}" PARENT_SCOPE)
    # Only rewrite when the content changes, so rebuilds stay incremental.
    if(EXISTS "${_dst}")
        file(READ "${_dst}" _old)
        if("${_old}" STREQUAL "${_text}")
            return()
        endif()
    endif()
    file(WRITE "${_dst}" "${_text}")
endfunction()

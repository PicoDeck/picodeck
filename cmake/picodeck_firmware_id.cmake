# The source revision a build came from, for sys->getFirmwareId (src/os/firmware_id.c).
#
#   picodeck_firmware_id(<target> <source dir>)
#
# adds a custom target that runs on every build and rewrites
# ${CMAKE_BINARY_DIR}/generated/firmware_id.h only when the revision changed, so a build with
# nothing to do relinks nothing. The id is `git rev-parse --short HEAD`, with "-dirty" when a
# tracked file differs from it, or a submodule's commit or tracked files do; untracked files
# never count, in a submodule either (third_party/miniz holds a miniz_export.h a build may
# generate). "unknown" where there is no git.
#
# Run as a script with -P, this file is that generator (tests/unit/test_firmware_id.py).
if(CMAKE_SCRIPT_MODE_FILE)
    set(id "unknown")
    execute_process(COMMAND git -C "${ROOT}" rev-parse --short HEAD
        OUTPUT_VARIABLE hash RESULT_VARIABLE rc
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0 AND hash)
        # No optional locks: a build must not get in the way of a git command running beside it.
        execute_process(COMMAND git -C "${ROOT}" --no-optional-locks status --porcelain
                                --untracked-files=no --ignore-submodules=untracked
            OUTPUT_VARIABLE changes RESULT_VARIABLE rc ERROR_QUIET)
        set(id "${hash}")
        if(NOT rc EQUAL 0 OR changes)
            set(id "${hash}-dirty")
        endif()
    endif()
    set(text "// Generated by cmake/picodeck_firmware_id.cmake: do not edit.\n#define PICODECK_FIRMWARE_ID \"${id}\"\n")
    set(old "")
    if(EXISTS "${OUT}")
        file(READ "${OUT}" old)
    endif()
    if(NOT old STREQUAL text)
        file(WRITE "${OUT}" "${text}")
    endif()
    return()
endif()

set(PICODECK_FIRMWARE_ID_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(picodeck_firmware_id target source_dir)
    set(out "${CMAKE_BINARY_DIR}/generated/firmware_id.h")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
    add_custom_target(${target}_firmware_id
        COMMAND ${CMAKE_COMMAND} -DROOT=${source_dir} -DOUT=${out}
                -P ${PICODECK_FIRMWARE_ID_SCRIPT}
        BYPRODUCTS ${out}
        COMMENT "Checking the firmware id"
        VERBATIM)
    add_dependencies(${target} ${target}_firmware_id)
    target_include_directories(${target} PRIVATE "${CMAKE_BINARY_DIR}/generated")
endfunction()
